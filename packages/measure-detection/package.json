  "files": ["dist", "models"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/unit.mjs && node test/parity.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "typescript": "^5.6.0"
  },
  "license": "UNLICENSED"
}
